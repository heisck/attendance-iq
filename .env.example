# Dev only: lets laptops open student pages. Never set in production.
NEXT_PUBLIC_DEV_ALLOW_DESKTOP=

# Sign-in "Forgot password?" link. Point it at this project's Vercel env vars page
# (https://vercel.com/<team>/<project>/settings/environment-variables), where
# LECTURER_PASSWORD is changed. Falls back to the Vercel dashboard.
NEXT_PUBLIC_PASSWORD_RESET_URL=
