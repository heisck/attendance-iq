# Copy to .env.local for development; set the same names in Vercel for production.

# Lecturer sign-in. Changing either signs every device out.
LECTURER_EMAIL=
LECTURER_PASSWORD=
# Shown in the top bar.
LECTURER_NAME=

# Signs the sign-in cookie, QR codes and node tokens. 32+ random characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
APP_SECRET=

# IANA timezone the lecturer types session times in.
APP_TIMEZONE=Africa/Accra

# Turso. Dev can use a local file: TURSO_DATABASE_URL=file:local.db (no token).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Upstash Redis (REST). Dev: see README for a local Redis + REST shim.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Face service on Modal: the URL printed by `modal deploy face/app.py`, and a proxy auth token
# from modal.com -> Settings -> Proxy Auth Tokens (ID starts wk-, secret starts ws-).
FACE_URL=
FACE_TOKEN_ID=
FACE_TOKEN_SECRET=

# Sign-in "Forgot password?" link. Point it at this project's Vercel env vars page
# (https://vercel.com/<team>/<project>/settings/environment-variables), where
# LECTURER_PASSWORD is changed. Falls back to the Vercel dashboard.
NEXT_PUBLIC_PASSWORD_RESET_URL=

# Dev only: lets laptops open student pages. Never set in production.
NEXT_PUBLIC_DEV_ALLOW_DESKTOP=
